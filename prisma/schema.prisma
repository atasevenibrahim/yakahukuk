// YAKA Hukuk — Prisma şeması.
// Bu dilimde yalnızca iletişim formu için ContactMessage modeli var;
// diğer içerikler (makale/ekip/çalışma alanı) hâlâ src/content/*.ts'te.
// Genişletme planı: YAKA_Hukuk_Claude_Code_Prompt.md Bölüm 5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  RESCHEDULED
  CANCELLED
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  locale    String

  status RequestStatus @default(NEW)

  // Admin panelinden eklenen dahili not (müvekkile gönderilmez).
  internalNote String?

  // KVKK onay kanıtı.
  kvkkConsent     Boolean
  kvkkTextVersion String

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())
}

model Appointment {
  id               String   @id @default(cuid())
  date             DateTime // gün (saat kısmı 00:00, Europe/Istanbul takvim günü)
  startTime        String   // "10:00"
  endTime          String   // "10:45"
  practiceAreaSlug String?
  name             String
  email            String
  phone            String
  subject          String? // kısa açıklama (opsiyonel)
  locale           String

  status AppointmentStatus @default(PENDING)

  internalNote String?

  kvkkConsent     Boolean
  kvkkTextVersion String

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  // Aynı slotta aynı statüde çift kayıt engeli (uygulama katmanında da kontrol edilir).
  @@unique([date, startTime, status])
}

model AvailabilityRule {
  id            String  @id @default(cuid())
  weekday       Int // 0=Pazartesi … 6=Pazar
  startTime     String // "09:00"
  endTime       String // "18:00"
  slotMinutes   Int     @default(45)
  bufferMinutes Int     @default(15)
  isActive      Boolean @default(true)
}

model BlockedDate {
  id     String   @id @default(cuid())
  date   DateTime
  reason String?
}

// --- Admin / kimlik doğrulama ---
// Not: Tam Role/Permission matrisi "Kullanıcılar & Roller" ekranı gelene kadar
// ertelendi; şimdilik tekil isSuperAdmin bayrağı yeterli (tek admin senaryosu).

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  isSuperAdmin Boolean @default(true)

  twoFAEnabled     Boolean  @default(false)
  twoFASecret      String? // AES-256-GCM ile şifreli saklanır (TWOFA_ENCRYPTION_KEY)
  backupCodeHashes String[] // argon2id hash'leri

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  sessions      Session[]
  resetTokens   PasswordResetToken[]

  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  module    String
  entityId  String?
  /// Serbest metin ek bilgi (ör. AI çağrılarının token kullanımı). Listede action etiketinin
  /// yanında gösterilir; yapılandırılmış sorgu yapılmadığı için ayrı sütunlara bölünmedi.
  detail    String?
  ip        String?
  userAgent String?
  /// "Ankara, TR" gibi kaba konum. Vercel'in edge katmanı her isteğe eklediği coğrafya
  /// başlıklarından okunur — harici bir geo-IP servisi kullanılmaz, yöneticinin IP'si
  /// üçüncü bir tarafa gitmez. Yerelde bu başlıklar olmadığı için null kalır.
  location  String?
  createdAt DateTime @default(now())
}

// Tek satırlık kurum ayarları (Admin Ayarlar → Genel sekmesi). src/content/site.ts'in
// yorumundaki "İleride SiteSettings tablosundan gelecek" notunun karşılığı.
model SiteSettings {
  id                 String   @id @default(cuid())
  phone              String
  email              String
  address            String
  hoursLabel         String
  notificationEmails String[]
  notifySound        Boolean  @default(true)
  seoTitle           String
  seoDescription     String
  updatedAt          DateTime @updatedAt
}

// --- İçerik (Admin İçerik / Admin Makaleler) ---
// `t` sütunları src/content/types.ts'teki Localized<T> = {tr: T} & Partial<Record<Locale,T>>
// şeklini birebir Json olarak taşır; pick() DB'den gelen nesnede de aynen çalışır.

model PracticeArea {
  id        String   @id @default(cuid())
  slug      String   @unique
  icon      String // IconName'in 30 değerinden biri (src/lib/icons.ts) — action'da doğrulanır
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  order     Int      @default(0)
  t         Json // Localized<{title, excerpt, whatWeDo: string[], typicalCases: string[]}>
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  bar          String
  tags         String[]
  areas        String[] // TR çalışma alanı başlıkları (slug değil — mevcut string-eşleşme korunur)
  languages    String[]
  articleSlugs String[]
  portraitUrl  String?
  published    Boolean  @default(true)
  order        Int      @default(0)
  t            Json // Localized<{role, roleShort, bio: string[], education: {period,text}[]}>
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PressItem {
  id        String   @id @default(cuid())
  slug      String   @unique
  date      String
  isoDate   DateTime
  tag       String // "BASIN" | "DUYURU"
  source    String?
  published Boolean  @default(true)
  order     Int      @default(0)
  t         Json // Localized<{title, excerpt, content}>
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id               String   @id @default(cuid())
  practiceAreaSlug String
  areaLabel        String
  initials         String
  monthLabel       String
  rating           Int
  published        Boolean  @default(true) // mockup'ın ONAYLI/BEKLİYOR durumu
  order            Int      @default(0)
  t                Json // Localized<{quote}>
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FaqCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  order     Int       @default(0)
  t         Json // Localized<{name}>
  items     FaqItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model FaqItem {
  id         String      @id @default(cuid())
  slug       String      @unique
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  published  Boolean     @default(true)
  order      Int         @default(0)
  t          Json // Localized<{question, answer}>
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model LegalDocument {
  id        String   @id @default(cuid())
  slug      String   @unique // "kvkk" | "aydinlatma" | "cerez"
  order     Int      @default(0)
  t         Json // Localized<{tabLabel, tag, title, intro, sections: {no,title,text}[]}>
  updatedAt DateTime @updatedAt
}

// Tek satırlık ana sayfa hero içeriği (SiteSettings ile aynı desen). Mockup'ın Ana Sayfa/Hero
// modülünün kapsamıyla sınırlı ("YAKA kimdir" değerleri/süreç adımları admin'e açılmıyor).
model HomeHero {
  id              String   @id @default(cuid())
  headline        String
  subtext         String
  closingCtaTitle String
  closingCtaText  String
  updatedAt       DateTime @updatedAt
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model Article {
  id               String        @id @default(cuid())
  slug             String        @unique
  practiceAreaSlug String?
  category         String
  readMinutes      Int           @default(5)
  tags             String[]
  coverImageUrl    String?
  featured         Boolean       @default(false)
  status           ArticleStatus @default(DRAFT)
  publishAt        DateTime?
  /// SEO odak anahtar kelimesi — SEO panelinin denetimleri (başlıkta/slug'da/ilk paragrafta
  /// geçiyor mu) bunun üzerinden çalışır. AI önerir, kullanıcı onaylar.
  focusKeyword     String?
  /// Kullanıcının "bu bilgiyi kaynaktan doğruladım" dediği atıfların kararlı anahtarları
  /// (bkz. lib/ai/citations.ts → CitationFinding.key). Kalıcı tutulması şart: aksi hâlde bir
  /// yazım hatasını düzeltmek için tüm atıfları yeniden onaylamak gerekirdi.
  verifiedClaims   String[]      @default([])
  t                Json // Localized<{title, excerpt, body: markdown string, metaTitle?, metaDescription?}>
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}
