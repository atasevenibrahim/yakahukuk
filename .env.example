# Ortam değişkenleri — gerçek değerler `.env.local`e yazılır (gitignore'da).
# Vercel'e de aynı adlarla eklenmesi gerekiyor.

# --- Zorunlu ---------------------------------------------------------------
# Supabase Postgres bağlantısı. Build sırasında 11 işçi paralel sorgu attığı için session
# pooler'ın (port 5432, pool_size 15) sınırına takılabiliyor; transaction pooler (port 6543)
# önerilir.
DATABASE_URL=

# Admin 2FA gizli anahtarlarının şifrelenmesinde kullanılır (32 baytlık rastgele değer).
TWOFA_ENCRYPTION_KEY=

# --- Yapay zeka (makale editörü) -------------------------------------------
# Google AI Studio'dan alınan ücretsiz katman anahtarı. Yoksa AI özellikleri kapalı görünür.
GEMINI_API_KEY=
# İsteğe bağlı model geçersiz kılma (varsayılan: gemini-3.6-flash).
AI_MODEL=

# --- Medya kütüphanesi (Supabase Storage) ----------------------------------
# `media` adında herkese açık bir bucket gerekir. service_role anahtarı YALNIZCA sunucuda
# kullanılır, hiçbir istemci bileşenine sızmamalıdır.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-posta bildirimleri (Resend) -----------------------------------------
# Yoksa gönderim atlanır, bildirimler sunucu günlüğüne yazılır; hiçbir akış çökmez.
# Alan adı doğrulanmadan önce MAIL_FROM boş bırakılabilir (Resend test göndericisi kullanılır).
RESEND_API_KEY=
MAIL_FROM="YAKA Hukuk <bildirim@yakahukuk.com>"
